# ============================================================
# GREENLIFE FLORA - RENDER PRODUCTION ENVIRONMENT EXAMPLE
# ============================================================

APP_NAME=GreenLifeFlora
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com

# Giữ APP_KEY cố định sau khi deploy.
APP_KEY=YOUR_APP_KEY

TRUSTED_PROXIES=*

# ============================================================
# AIVEN MYSQL
# ============================================================

DB_CONNECTION=mysql
DB_HOST=YOUR-AIVEN-HOST
DB_PORT=YOUR-AIVEN-PORT
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=YOUR-AIVEN-PASSWORD

MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

# ============================================================
# SESSION / CACHE / QUEUE
# ============================================================

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync

# ============================================================
# LOG
# ============================================================

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ============================================================
# RENDER / STARTUP
# ============================================================

PORT=10000

RUN_MIGRATIONS=true
RUN_SEEDERS=false

# ============================================================
# MAIL
# ============================================================

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=GreenLifeFlora

# ============================================================
# SEED ADMIN
# Chỉ dùng khi RUN_SEEDERS=true
# ============================================================

SEED_ADMIN_NAME=Shop Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_WITH_AT_LEAST_12_CHARACTERS